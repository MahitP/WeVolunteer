# WeVolunteer Environment Configuration Template
# Copy this file to .env and fill in the values before deploying to production.

# Application URL (Required for production password resets)
APP_URL=https://wevolunteer.example.org
APP_NAME="WeVolunteer"

# Database Configuration
# In production, this usually defaults to data.db inside the container.
WEV_DB_PATH=data.db

# Security
# Set this to a long, random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key

# Two-Factor Authentication
#
# AES-256 key used to encrypt stored TOTP secrets, base64, exactly 32 bytes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Required in production — the server refuses to boot without it. In development
# an insecure built-in key is used and a warning is printed.
#
# Treat this like a database backup key: if it is lost or rotated, every stored
# TOTP secret becomes undecryptable and every enrolled user has to enrol again
# (bin/reset-2fa.mjs clears one account at a time).
#
# Define it EXACTLY ONCE. Node's --env-file is last-wins, so a second
# TFA_ENCRYPTION_KEY line further down silently shadows the one above it and the
# file gives no indication which is in force. A local .env carried two different
# keys this way until 2026-08-09; only the last could decrypt anything, and
# deduplicating it by keeping the first would have destroyed every enrolled
# authenticator. If you are ever unsure which of two keys is live, test one
# against a stored secret before changing anything — do not guess.
TFA_ENCRYPTION_KEY=

# Whether an administrator must hold a second factor to use their privileges.
#
# Defaults to ON when unset, which is what production must run. Setting it to
# "false" while NODE_ENV=production is a fatal boot error.
#
# The demo database seeds an administrator with no authenticator enrolled, so
# on a local demo you will meet the enrolment wall on first sign-in. Enrol
# through Settings → Security, or uncomment the line below to switch the policy
# off for this machine only.
# REQUIRE_ADMIN_2FA=false


# OAuth Configuration
#
# Leave the credentials empty and the provider is simply not offered as a
# sign-in option — email sign-in is a fully supported deployment. Setting them
# turns the real flow on; there is no half-configured state that silently
# pretends to work.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Microsoft (Entra ID). Needs an Azure App Registration — see
# deploy/wevolunteer.env.example for what to configure there. MICROSOFT_TENANT_ID
# is optional and defaults to `common`, which accepts any Microsoft account;
# set the tenant GUID to restrict sign-in to one directory.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# The OAuth test transport. OFF unless this is exactly "true".
#
# It skips the provider entirely and takes the identity from the request body, so
# it must never be on anywhere real — a production process that finds it enabled
# refuses to boot. It used to default to ON outside production, which is how a
# developer holding working Google credentials got "Mock User" prefilled into the
# signup form after a genuine round trip to Google. Automated tests set it
# themselves; you should not need it.
# OAUTH_ALLOW_MOCK=false

# Outbound mail. Resend is the primary provider; SMTP is the emergency
# fallback; anything neither of them takes waits in a durable outbox.
# Production needs at least one of the two — with neither, it refuses to boot
# rather than fall back to the console mock, which prints reset tokens.

# Resend API key, with SEND permission only. A SECRET: never commit it, never
# put it in a VITE_ variable, never log it.
RESEND_API_KEY=your-resend-api-key

# The domain every platform address lives on (noreply@, support@, admin@,
# legal@, privacy@, security@, platform@, contact@). Must be verified with
# Resend and covered by SPF/DKIM.
MAIL_DOMAIN=wevolunteers.org

# Signing secret for the Resend delivery webhook. Without it the webhook
# endpoint refuses everything (fail closed). Issued by Resend when the webhook
# is created; a SECRET, same rules as the API key.
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# The fallback relay.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password

# EMAIL_FROM is no longer used — the sender is chosen per message from what the
# message is. See server/emailIdentity.js. Set MAIL_DOMAIN instead.

# Amplitude analytics. Leave EMPTY to switch analytics off — the application
# logs "Amplitude API key missing — analytics disabled" and runs normally.
#
# The key is public by design (it is inlined into the browser bundle at build
# time by Vite), so this is not a secret in the way JWT_SECRET is. It lives in
# an env var anyway so that each environment can point at its OWN Amplitude
# project: one key across dev and production means developer clicks and student
# activity land in the same dataset, and every chart has to remember to filter.
#
# Vite inlines this at BUILD time, not at run time. A variable that is unset
# when `npm run build` runs cannot be supplied later by the server environment.
VITE_AMPLITUDE_API_KEY=

# On-device AI (Welly). ON BY DEFAULT — leave this unset unless you want it OFF.
#
# The default lives in vite.config.js, not here, and deliberately so: `.env` is
# not committed, so any default written in this file is one a deployment can
# miss. Welly used to be opt-in and the result was a feature that was invisible
# unless somebody remembered an undocumented variable — silently, with no error
# and no launcher. A default that travels with the repository cannot be
# forgotten.
#
# Set to "false" (or empty) to build WITHOUT it. Off means absent rather than
# hidden: the runtime and the PDF parser sit behind dynamic imports that Vite
# drops entirely, so an opted-out build carries none of the 9.4 MB the feature
# adds. src/ai/bundleCost.test.js asserts the shape that guarantees it, and
# `node bin/verify-ai-bundle.mjs` measures two real builds.
#
# ON switches on the OFFER, not a download. Nothing is fetched until somebody
# opens Welly, reads what the model is and how large, and chooses one. A device
# that cannot run the smallest model is never offered it. The 7.5 MB WebAssembly
# runtime is its own chunk and is not touched on page load either.
#
# Model weights come from Hugging Face over the network. The hosts are
# allowlisted in the CSP at server/app.js — see the connect-src comment there
# before changing where models are served from.
#
# Like the key above, Vite inlines this at BUILD time, not at run time.
#
#     npm run dev         Welly available (the default)
#     npm run dev:no-ai   the opted-out build, for exercising that path
#
VITE_LOCAL_AI=
