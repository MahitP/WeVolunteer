# =============================================================================
# WeVolunteer — environment variable template
# =============================================================================
#
# Copy this file to `.env` for LOCAL DEVELOPMENT and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is git-ignored and is development-only. A production server does NOT
# read it — systemd passes /etc/wevolunteer/wevolunteer.env to the service
# instead (see deploy/wevolunteer.service and deploy/wevolunteer.env.example).
#
# ── How these are loaded ─────────────────────────────────────────────────────
#
#   server        node --env-file-if-exists=../.env   (server/package.json)
#   root scripts  node --env-file-if-exists=.env      (package.json)
#   the browser   Vite, via loadEnv(mode, cwd, 'VITE_')
#
# Vite reads `.env` too, but exposes ONLY names beginning with `VITE_`. That
# prefix is therefore the whole security boundary: a `VITE_` variable is
# PUBLIC — it is compiled into the bundle and readable with View Source — and
# anything without it never leaves the server. Never give a secret a VITE_ name.
#
# ── Reading this file ────────────────────────────────────────────────────────
#
#   VARIABLE=value    shown uncommented: what a working local setup usually sets
#   # VARIABLE=value  commented: optional, or an override with a default in code
#
# Required in production (the process refuses to boot without them):
#
#   JWT_SECRET             a long random string, not the placeholder
#   TFA_ENCRYPTION_KEY     32 random bytes, base64
#   TRUST_PROXY            the number of proxies in front of this process
#   RESEND_API_KEY         …or the SMTP_* block; at least one mail path
#   DATABASE_URL           only when DATABASE_ENGINE=postgres
#
# Every other variable here is optional and has a documented default.

# ============================================
# Application
# ============================================

# Application URL (Required for production password resets)
APP_URL=https://wevolunteer.example.org
APP_NAME="WeVolunteer"

# ============================================
# Database
# ============================================

# Database Configuration
# In production, this usually defaults to data.db inside the container.
WEV_DB_PATH=data.db

# Unset means "sqlite", which is what every deployment ran before 2026-08-18.
# `postgres` is supported and boot-tested; the cutover procedure, its rollback,
# and what each step costs are in docs/operations/postgres-cutover-and-rollback.md.
#
# A typo is a refusal, never a fallback: DATABASE_ENGINE=postgre stops the boot
# rather than quietly opening SQLite, because a silent fallback looks exactly
# like a successful migration.
#
# DATABASE_ENGINE=postgres

# ── Realtime across multiple backend instances ────────────────────────────────
#
# Socket.IO rooms live in the process that owns the socket. With ONE instance —
# which `instanceLock.js` enforces, and which is what this deployment runs —
# that is invisible and correct. With two and no adapter, a broadcast reaches
# only the clients attached to the instance that handled the write, so
# notifications, messages and read receipts are delivered to roughly half the
# connected users, silently.
#
# Leave REALTIME_ADAPTER unset unless you are actually running more than one
# backend instance. Unset is the deployed state and the package is not even
# loaded.
#
# When you do: `postgres` is the only supported value. The adapter broadcasts
# over LISTEN/NOTIFY, so the bus is the database that is already here — no new
# service, no new credential, no new free-tier ceiling.
# REALTIME_ADAPTER=postgres

# The adapter's OWN connection string, and it must not go through a
# transaction-mode pooler.
#
# LISTEN holds state on a connection between statements. Supavisor in
# TRANSACTION mode (port 6543) returns the connection to the pool after every
# transaction, so the LISTEN is simply gone — no error, no notifications, and a
# cluster that looks healthy while broadcasting nothing.
#
# DATABASE_URL above is meant to point at exactly that pooler, which is right
# for the application's own queries. So this is deliberately NOT defaulted to
# it: inheriting it would be correct on a direct connection and broken on the
# pooler the runbook recommends. Setting REALTIME_ADAPTER without this stops the
# boot.
#
# Use the SESSION-mode pooler (port 5432 on the pooler host) or a direct
# connection.
# REALTIME_ADAPTER_URL=postgres://user:password@aws-0-region.pooler.supabase.com:5432/postgres


# The PostgreSQL connection string. REQUIRED when DATABASE_ENGINE=postgres.
#
# It carries the password, so it is never logged — the server prints only host
# and database name. It must NOT be given a VITE_ prefix under any circumstances:
# those are compiled into the browser bundle.
#
# WEV_DB_PATH above is ignored on PostgreSQL, and a leftover relative value there
# is harmless. That was not always true: until 2026-08-18 it aborted the boot.
#
# DATABASE_URL=postgres://user:password@host:5432/wevolunteer

# ── DO NOT put a production DATABASE_URL in the repository-root `.env` ─────────
#
# `.env` is the DEVELOPMENT config, and far more reads it than is obvious. Every
# npm script passes `--env-file-if-exists=.env`; `bin/resolveDb.mjs` loads it for
# all seven privileged CLI tools (grant-ownership, revoke-ownership, make-admin,
# bootstrap-owners, suspend-account, reset-2fa, clear-stale-tfa-secret); and the
# vitest suites inherit it from the shell. A production connection string there
# is therefore reachable by `npm test`, which is exactly what happened: the seven
# `tooling.privilegedDbPath` cases that assert those scripts fail CLOSED without
# a DATABASE_URL failed by connecting to the live database and running a lookup.
#
# Production is configured from the DEPLOYMENT environment —
# `deploy/wevolunteer.service` uses `EnvironmentFile=/etc/wevolunteer/wevolunteer.env`
# — and one-off operator work names its file per command:
#
#   node --env-file=.env.operator bin/reset-2fa.mjs someone@example.org
#
# Keep `.env` on SQLite and a local file. See the guard below for what happens
# if this advice is ignored.

# The production database's FINGERPRINTS, which is what makes the advice above
# enforceable rather than a convention. A COMMA-SEPARATED LIST.
#
# Each entry is a sha256 over `user@host:port/database` with the PASSWORD
# excluded. Excluding the password is what makes rotation safe — a guard that
# stopped matching when the password changed would fail open exactly when
# nobody is watching. Including the username is what makes an entry identify a
# DATABASE rather than a route to one: on a managed provider the hostname is
# shared (every Supabase project in a region sits behind the same
# `aws-0-<region>.pooler.supabase.com` with the default database `postgres`),
# and the project is named in the pooler username.
#
# It is a LIST because host and port are both hashed, so every endpoint for one
# database fingerprints differently — the session pooler, the transaction
# pooler on 6543, and the direct `db.<ref>.supabase.co` connection that
# docs/operations/database-credential-rotation.md tells operators to use. A
# single value covered one of the three and passed the other two silently.
# Add every endpoint the deployment can be reached through.
#
# A fingerprint is not a credential — it grants nothing, and rotating the
# password does not change it — but do not treat it as opaque either. The
# hostname half of the preimage is guessable by enumeration for a known
# provider, so a fingerprint confirms a host rather than concealing one. Keep
# real values in the gitignored `.env`, not in this committed template.
#
# With it set, `server/db/productionDatabaseGuard.js` refuses any process whose
# deployment environment is not production (VERCEL_ENV, else NODE_ENV) but whose
# DATABASE_URL fingerprints to this value — on the server's connection path AND
# on the privileged CLI path, which does not import the server's engine module
# and so had to be wired separately. Under vitest NODE_ENV is `test`, so the
# suites are covered.
#
# Unset, the guard is INERT. That is deliberate: a guard that guessed which
# databases are production would refuse legitimate staging deployments, and a
# guard that cries wolf gets switched off. Setting it is a launch-checklist item.
#
#   DATABASE_URL="…" node bin/db-fingerprint.mjs
#
# Prefer that form over passing the URL as an argument: an argument is
# visible in the process table to any local user and lands in shell history,
# and the URL carries the password.
#
# WEV_PRODUCTION_DB_FINGERPRINT=

# How many PostgreSQL connections this process may hold. Default 10; a value
# outside 1-100 is a fatal boot error rather than a silent clamp.
#
# One process is the supported topology (see the single-instance lock), so this
# is the whole application's budget, not a per-worker one. Raise it only with
# evidence: the pool failing closed under load is visible and recoverable, and
# exhausting the SERVER's connection limit is neither.
# DATABASE_POOL_MAX=10

# ── Database TLS ─────────────────────────────────────────────────────────────
#
# Supabase does not use a public CA. It presents
#
#     db.<ref>.supabase.co -> Supabase Intermediate 2021 CA -> Supabase Root 2021 CA
#
# and that root is self-signed and absent from Node's trust store, so a
# verifying connection fails with SELF_SIGNED_CERT_IN_CHAIN. The root is a
# PUBLIC certificate, not a secret, and is committed at the path below.
#
# Point this at the file, or paste the PEM inline for platforms that offer only
# environment variables and no filesystem to mount a cert into. With it set,
# certificate verification stays ON and the server's identity is actually
# checked — which is the entire point of TLS here.
#
# Not needed for a local PostgreSQL server: TLS is off for localhost unless
# DATABASE_SSL=true.
DATABASE_SSL_CA=deploy/certs/supabase-root-2021.crt

# Disables certificate verification. FATAL in production, on purpose.
#
# For a developer pointing at a local server with a throwaway certificate. In
# production it means every connection is encrypted to an unverified peer, which
# reads as secure in a log and is not — so the boot refuses rather than allowing
# a temporary measure to become the deployed configuration. Use DATABASE_SSL_CA.
# DATABASE_SSL_INSECURE=true

# ============================================
# Authentication & security
# ============================================

# Security
# Set this to a long, random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key

# Two-Factor Authentication
#
# AES-256 key used to encrypt stored TOTP secrets, base64, exactly 32 bytes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Required in production — the server refuses to boot without it. In development
# an insecure built-in key is used and a warning is printed.
#
# Treat this like a database backup key: if it is lost or rotated, every stored
# TOTP secret becomes undecryptable and every enrolled user has to enrol again
# (bin/reset-2fa.mjs clears one account at a time).
#
# Define it EXACTLY ONCE. Node's --env-file is last-wins, so a second
# TFA_ENCRYPTION_KEY line further down silently shadows the one above it and the
# file gives no indication which is in force. A local .env carried two different
# keys this way until 2026-08-09; only the last could decrypt anything, and
# deduplicating it by keeping the first would have destroyed every enrolled
# authenticator. If you are ever unsure which of two keys is live, test one
# against a stored secret before changing anything — do not guess.
TFA_ENCRYPTION_KEY=

# Whether an administrator must hold a second factor to use their privileges.
#
# Defaults to ON when unset, which is what production must run. Setting it to
# "false" while NODE_ENV=production is a fatal boot error.
#
# The demo database seeds an administrator with no authenticator enrolled, so
# on a local demo you will meet the enrolment wall on first sign-in. Enrol
# through Settings → Security, or uncomment the line below to switch the policy
# off for this machine only.
# REQUIRE_ADMIN_2FA=false

# OAuth Configuration
#
# Leave the credentials empty and the provider is simply not offered as a
# sign-in option — email sign-in is a fully supported deployment. Setting them
# turns the real flow on; there is no half-configured state that silently
# pretends to work.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Microsoft (Entra ID). Needs an Azure App Registration — see
# deploy/wevolunteer.env.example for what to configure there. MICROSOFT_TENANT_ID
# is optional and defaults to `common`, which accepts any Microsoft account;
# set the tenant GUID to restrict sign-in to one directory.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# The OAuth test transport. OFF unless this is exactly "true".
#
# It skips the provider entirely and takes the identity from the request body, so
# it must never be on anywhere real — a production process that finds it enabled
# refuses to boot. It used to default to ON outside production, which is how a
# developer holding working Google credentials got "Mock User" prefilled into the
# signup form after a genuine round trip to Google. Automated tests set it
# themselves; you should not need it.
# OAUTH_ALLOW_MOCK=false

# ============================================
# Email
# ============================================

# Outbound mail. Resend is the primary provider; SMTP is the emergency
# fallback; anything neither of them takes waits in a durable outbox.
# Production needs at least one of the two — with neither, it refuses to boot
# rather than fall back to the console mock, which prints reset tokens.

# Resend API key, with SEND permission only. A SECRET: never commit it, never
# put it in a VITE_ variable, never log it.
RESEND_API_KEY=your-resend-api-key

# The domain every platform address lives on (noreply@, support@, admin@,
# legal@, privacy@, security@, platform@, contact@). Must be verified with
# Resend and covered by SPF/DKIM.
MAIL_DOMAIN=wevolunteers.org

# Signing secret for the Resend delivery webhook. Without it the webhook
# endpoint refuses everything (fail closed). Issued by Resend when the webhook
# is created; a SECRET, same rules as the API key.
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# The fallback relay.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password

# EMAIL_FROM is no longer used — the sender is chosen per message from what the
# message is. See server/emailIdentity.js. Set MAIL_DOMAIN instead.

# ============================================
# Frontend — VITE_ names are PUBLIC
# ============================================

# Amplitude analytics. Leave EMPTY to switch analytics off — the application
# logs "Amplitude API key missing — analytics disabled" and runs normally.
#
# The key is public by design (it is inlined into the browser bundle at build
# time by Vite), so this is not a secret in the way JWT_SECRET is. It lives in
# an env var anyway so that each environment can point at its OWN Amplitude
# project: one key across dev and production means developer clicks and student
# activity land in the same dataset, and every chart has to remember to filter.
#
# Vite inlines this at BUILD time, not at run time. A variable that is unset
# when `npm run build` runs cannot be supplied later by the server environment.
VITE_AMPLITUDE_API_KEY=

# On-device AI (Welly). ON BY DEFAULT — leave this unset unless you want it OFF.
#
# The default lives in vite.config.js, not here, and deliberately so: `.env` is
# not committed, so any default written in this file is one a deployment can
# miss. Welly used to be opt-in and the result was a feature that was invisible
# unless somebody remembered an undocumented variable — silently, with no error
# and no launcher. A default that travels with the repository cannot be
# forgotten.
#
# Set to "false" (or empty) to build WITHOUT it. Off means absent rather than
# hidden: the runtime and the PDF parser sit behind dynamic imports that Vite
# drops entirely, so an opted-out build carries none of the 9.4 MB the feature
# adds. src/ai/bundleCost.test.js asserts the shape that guarantees it, and
# `node bin/verify-ai-bundle.mjs` measures two real builds.
#
# ON switches on the OFFER, not a download. Nothing is fetched until somebody
# opens Welly, reads what the model is and how large, and chooses one. A device
# that cannot run the smallest model is never offered it. The 7.5 MB WebAssembly
# runtime is its own chunk and is not touched on page load either.
#
# Model weights come from Hugging Face over the network. The hosts are
# allowlisted in the CSP at server/app.js — see the connect-src comment there
# before changing where models are served from.
#
# Like the key above, Vite inlines this at BUILD time, not at run time.
#
#     npm run dev         Welly available (the default)
#     npm run dev:no-ai   the opted-out build, for exercising that path
#
VITE_LOCAL_AI=

# ============================================
# Pinecone / Discover Intelligence (optional)
# ============================================

# Off unless PINECONE_API_KEY is set. With it unset, Discover uses the database
# substring search it has always used — a complete answer, not a degraded one.
#
# SERVER-SIDE ONLY. Never prefix any of these with VITE_: that would compile the
# key into the browser bundle, where it is a write credential for your index
# that anyone can read with View Source.
#
# PINECONE_API_KEY=pcsk_...
#
# The index name carries its schema version. Bumping the version means a new
# index and a fresh backfill; see docs/operations/pinecone.md.
# PINECONE_INDEX=wevolunteer-discover-v1
#
# Namespaces separate deployments inside ONE index. Defaults to NODE_ENV, so a
# developer who sets only the API key cannot write test events into production.
# Starter allows 100 namespaces per index and only 5 indexes, so namespaces are
# the right axis to separate on.
# PINECONE_NAMESPACE=development
#
# Starter indexes MUST be in us-east-1 on AWS. These exist for a later plan.
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
#
# Skips one control-plane round trip per boot. Optional — the host is resolved
# and remembered automatically.
# PINECONE_INDEX_HOST=
#
# How similar a candidate must be before it counts as a match at all.
#
# A vector index returns the K NEAREST records and has no notion of "nothing
# matched", so without a floor a search for something the corpus does not
# contain returns the whole corpus. Measured against the live index on
# 2026-08-28: relevant queries scored 0.2585-0.5057, nonsense 0.0124-0.1058.
# Re-measure if you change the embedding model or the corpus changes character.
# PINECONE_MIN_SCORE=0.15
#
# Reranking is OPT-IN. The Starter plan allows 500 rerank requests per MONTH,
# about sixteen a day, so this is a budget decision rather than a quality one.
# Leave it off unless you have measured your search volume.
# PINECONE_RERANK=0
# PINECONE_RERANK_BUDGET=400
#
# How long Discover waits for the semantic half before answering with the
# database results alone.
# PINECONE_SEARCH_TIMEOUT_MS=1200
#
# How often the background worker drains the index queue.
# PINECONE_SYNC_INTERVAL_MS=15000
#
# How long a candidate list is remembered in this process, and how many are
# kept. The cache means page two of a search, and the same search from a second
# student, cost no vendor call. Raising the TTL saves more calls and delays how
# soon a newly indexed event can be proposed SEMANTICALLY — never how soon it
# can be found, because the lexical half of the search is never cached and the
# database applies every filter afterwards. Set the TTL to 0 to disable.
# PINECONE_CANDIDATE_TTL_MS=60000
# PINECONE_CANDIDATE_MAX=500
#
# The read-path circuit breaker. After this many consecutive vendor failures
# (timeouts, 5xx and 429 — never a 400, which is this application being wrong)
# searches stop calling Pinecone for the cooldown and answer from the database
# alone, which is what Discover was before the integration existed. Without it
# an outage costs EVERY search the full PINECONE_SEARCH_TIMEOUT_MS.
# PINECONE_BREAKER_FAILURES=3
# PINECONE_BREAKER_COOLDOWN_MS=30000

# ============================================
# Upstash Redis (optional)
# ============================================

# Off unless BOTH variables below are set. With them unset the application
# behaves exactly as it always has: every rate limiter counts in process memory
# and every third-party lookup cache lives in this process and dies with it.
# Redis is NEVER required to serve a request.
#
# SERVER-SIDE ONLY. Never prefix either of these with VITE_: that would compile
# a full-privilege database token into the browser bundle, where anyone can read
# it with View Source.
#
# What it is used for, and deliberately not used for:
#   USED   the account lockout (ten failed passwords per account) plus the mail,
#          re-authentication, appeal and certificate-check limiters, so a
#          restart no longer clears an in-progress lockout;
#   NOT    the three per-device sign-in limiters. They set
#          skipSuccessfulRequests, so they bill on successful sign-ins too, and
#          sharing them costs more than the whole rest of this integration
#          combined — 107% of the monthly allowance at 1,000 users. See
#          docs/operations/upstash.md §4.
#   USED   caching weather and address lookups, so a deploy does not re-warm
#          them against somebody else's usage policy;
#   NOT    sessions, chat, the leaderboard, or ANY database query. The hot
#          queries here are 0.3-0.5 ms and an Upstash round trip is far slower,
#          so caching them would be a regression that also costs quota.
# Full reasoning: docs/operations/upstash.md
#
# Create a database in the Upstash console (https://console.upstash.com):
# choose REGIONAL, not global — a global database replicates writes to read
# regions and counts each replication as a command, doubling the spend for a
# single-server deployment. Pick the region nearest this host. The console's
# "REST API" tab gives you both values below.
#
# UPSTASH_REDIS_REST_TOKEN is a WRITE credential for the whole database. Treat
# it like a password: never commit it, never put it in a VITE_ variable, and
# rotate it in the Upstash console if it leaks.
# UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token-here
#
# The free plan allows ONE database, so development, test and production share a
# keyspace and the prefix is the only thing separating them. It defaults to
# NODE_ENV, so a developer who sets only the credentials cannot write test
# counters into production's. Set this only when two deployments share a
# NODE_ENV.
# UPSTASH_KEY_PREFIX=production
#
# How long one Upstash call may take before the caller gives up and uses its
# fallback. Short on purpose: every caller has a correct answer without Redis,
# so waiting is worse than falling back.
# UPSTASH_TIMEOUT_MS=800
#
# How long the circuit breaker stays open after a failure. Without it an outage
# costs one timeout on every request that would have used Redis, which turns a
# degraded dependency into a degraded sign-in page.
# UPSTASH_BREAKER_MS=30000

# ============================================
# Telemetry — Better Stack (optional)
# ============================================

# Structured logs and errors sent to Better Stack. Entirely optional: with these
# unset the application logs to stdout exactly as it always has, and every
# telemetry call is a no-op. Better Stack is NEVER required to serve a request.
#
# Create a source in Better Stack (Telemetry → Sources → Connect source →
# "JavaScript · Node.js"). It gives you a source token and an ingesting host;
# put them here. Full setup and the privacy boundary: docs/operations/betterstack.md
#
# The token is a WRITE credential for your log stream. Treat it like a password:
# never commit it, never put it in a VITE_-prefixed variable (those are compiled
# into the browser bundle), and rotate it in the Better Stack dashboard if it
# leaks.
# BETTERSTACK_SOURCE_TOKEN=your-source-token-here
# BETTERSTACK_INGESTING_HOST=sXXXXXXX.your-region.betterstackdata.com

# What fraction of SUCCESSFUL requests are logged, 0–1. Errors, refusals and
# slow requests are always logged regardless of this. The default keeps a
# district's morning-registration traffic from burying the events that matter.
# TELEMETRY_SAMPLE_RATE=0.05

# The `service` field on every record. Set it when one Better Stack account
# receives logs from more than one deployment, so they can be told apart.
# TELEMETRY_SERVICE_NAME=wevolunteer

# The `release` field on every record. Defaults to the version in
# server/package.json; set it to a commit SHA if you deploy from one, so Better
# Stack can group by what actually shipped.
# APP_RELEASE=

# ============================================
# Telemetry — OpenTelemetry traces and metrics (optional)
# ============================================

# Same source, same token, same vendor as the logs above — three signals on one
# Better Stack source. Nothing below needs to be set: with the two variables
# above unset, traces and metrics are off exactly as logs are, and every call
# into the SDK is a no-op.
#
# Why logs stay on the sink above rather than moving to OpenTelemetry: the OTel
# JavaScript project marks Traces and Metrics Stable and Logs "Development".
# The log path here carries a reviewed field allowlist and redaction pass, and
# is not being traded for a signal its own project calls unstable.
# See docs/operations/observability.md.

# An explicit off switch for traces and metrics ONLY, leaving log telemetry on.
# For an operator who wants to cut vendor traffic during an incident, or measure
# the application without the SDK. Anything other than "false" leaves it on.
# WEV_OTEL_ENABLED=false

# Fraction of ORDINARY traces kept, 0–1. Failed traces (5xx, recorded
# exceptions) and slow ones (>1s) are kept regardless of this number — that is
# what tail sampling buys, and it is why this can be so low.
#
# The default is derived from the Better Stack free plan, not chosen for taste:
# the plan includes 3 GB of traces a month and BILLS beyond it. Unsampled, the
# traffic this deployment is sized for produces roughly 4.5 GB/month — the free
# plan exceeded by ordinary operation. At 0.02 the same traffic costs ~90 MB,
# and a tenfold traffic surprise still lands inside the allowance.
#
# Raising this is the single easiest way to start paying Better Stack. Check the
# usage page first.
# OTEL_TRACE_SAMPLE_RATE=0.02

# The hard ceiling: spans this process may export in any rolling 24 hours.
#
# Sampling is a RATE, and a rate times unexpected traffic is still unbounded — a
# crawler, a retry storm or a one-second uptime check all raise the denominator
# without anybody changing a setting. This is the bound that does not care why
# the traffic arrived.
#
# When it is reached: trace sampling goes to zero until the window rolls, one
# line is written to the journal, and the refusals are counted on the
# `wev.telemetry.traces` metric. Requests are served normally, every error is
# still logged, and metrics still describe the whole population.
#
# 200,000 spans/day at ~500 bytes is ~3 GB over a 30-day month, which is exactly
# the free trace allowance — so a month spent AT the ceiling lands on the free
# plan rather than past it. Set to 0 to disable tracing while keeping metrics.
# OTEL_TRACE_DAILY_SPAN_BUDGET=200000

# Turns on the OpenTelemetry SDK's own diagnostic logging (`debug`). Very loud,
# and it logs an export failure on every batch while an endpoint is down. Needed
# to see OTLP delivery problems at all: unlike the log sink, the exporters do
# not report their own failures to the journal. Verified not to print the token.
# WEV_OTEL_DIAG=debug

# ============================================
# Telemetry — reading it back (operator tooling only)
# ============================================
#
# The APPLICATION NEVER READS THESE. They are used only by
# bin/betterstack-live-check.mjs, to prove that telemetry sent by this instance
# can actually be found in Better Stack — which HTTP 202/200 does not prove.
#
# Better Stack has three separate credentials and they are not interchangeable:
#
#   BETTERSTACK_SOURCE_TOKEN   writes telemetry          (the app needs this)
#   BETTERSTACK_API_TOKEN      reads source CONFIGURATION (Telemetry API token)
#   the ClickHouse connection  reads TELEMETRY itself     (username + password)
#
# The last one is created in Better Stack under Integrations -> SQL API
# ("Connect ClickHouse HTTP client"). It is free and team-scoped, the password is
# shown once and cannot be recovered, and it can be revoked at any time.
#
# BETTERSTACK_API_TOKEN=your-telemetry-api-token
# BETTERSTACK_QUERY_HOST=your-region-connect.betterstackdata.com
# BETTERSTACK_QUERY_USERNAME=your-clickhouse-username
# BETTERSTACK_QUERY_PASSWORD=your-clickhouse-password

# ============================================
# Production deployment & networking
# ============================================

# These were read by the server but absent from this file until 2026-08-18. The
# first is the one that matters most: a production process REFUSES TO BOOT
# without it, so an operator configuring from this file alone could not start
# the application at all.

# How many reverse proxies sit in front of this process. REQUIRED in production.
#
# Without it Express takes the client IP from the socket, which behind a proxy is
# the proxy — so every visitor shares one rate-limit bucket and one login-failure
# counter. Setting it too high is the opposite hazard: Express then trusts a
# client-supplied X-Forwarded-For, and a caller can spoof an address to escape
# the limiter entirely. Count the hops and state them.
#
#     TRUST_PROXY=1      one nginx/Caddy in front (the usual answer)
#
TRUST_PROXY=

# The address to bind, and the port. Bind to loopback when a proxy terminates TLS.
# BIND_ADDRESS=127.0.0.1
# API_PORT=5050

# Which origins may call the API from a browser.
#
# Production serves the built client from this same process, so the API is
# same-origin and this is usually irrelevant. It matters for the websocket and
# for any split-origin deployment.
#
# Unset in production means NO cross-origin caller is allowed; same-origin
# requests still pass, so the single-host topology needs nothing here. Unset in
# development means the local Vite origins.
#
# The development default used to apply in production too. The note here said
# that was "a refusal, not an opening" on the grounds that localhost cannot
# match a real site — which had it backwards: it does match localhost, so any
# dev server or local tool on port 5173/4173 could call the live API with the
# user's credentials and read the replies. A loopback origin in production is
# now refused at boot rather than honoured.
# CORS_ORIGINS=https://volunteers.example.org

# Where a fatal error alert is sent. Unset means alerts are not sent at all.
# ALERT_EMAIL=ops@example.org

# ============================================
# Other services & behaviour
# ============================================

# Demo seeding. MUST NOT be set in production — the process refuses to start,
# because the demo accounts share a password published in this repository.
# DEMO_MODE=true

# The accessibility harness's exemption from the API VOLUME limiter.
#
# MUST NOT be set in production — the process refuses to start, and config.js
# declines to honour it there regardless. `npm run a11y` drives every route as
# every seeded role and makes more than the 10,000 requests per fifteen minutes
# `apiLimiter` allows, so without this the audit exhausts the ceiling partway
# through and the remaining specs fail with 429s that say nothing about
# accessibility.
#
# It exempts the volume limiter and nothing else: login, the per-address login
# ceiling, signup, mail, reauth, 2FA, error reports and check-in all still count
# these requests. `bin/a11y-audit.mjs` sets it; nothing else that ships does.
# WEV_A11Y_HARNESS=1

# Whether a new account must confirm its address before signing in.
# REQUIRE_EMAIL_VERIFICATION=false

# Where nightly backups and generated data exports are written.
# WEV_BACKUP_DIR=/var/lib/wevolunteer/backups
# WEV_EXPORT_DIR=/var/lib/wevolunteer/exports

# How strictly the volume limiters are enforced across instances. [coordinated]
#
#   coordinated  Exact within an instance; reconciled through Redis only once a
#                caller passes a quarter of the ceiling. Across N instances the
#                bound is `limit + N x (escalateAt - 1)` rather than `N x limit`.
#                Costs ZERO commands for callers below the threshold, which is
#                nearly everybody — and that is the whole point, because
#                metering every /api request would cost about 6,600 commands per
#                user per month against a free plan that allows 500.
#
#   exact        Every request metered. Globally exact for any number of
#                instances. Costs 3 commands per request, which the Upstash free
#                plan cannot carry — but a Redis or Valkey plan that meters
#                CONNECTIONS rather than commands would not notice. This is the
#                setting to change when moving to such a provider; nothing in
#                the code needs to change with it.
#
#   local        Off Redis entirely. An operator's lever for taking a limiter
#                out of a Redis incident without a deploy. Correct for one
#                instance, multiplies across several.
#
# An unrecognised value stops the boot rather than defaulting, because a typo
# here would silently change how strictly every volume limit is enforced.
# RATE_LIMIT_MODE=coordinated
