{
  "name": "wevolunteer-server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.js",
    "dev": "DEMO_MODE=true JWT_SECRET=${JWT_SECRET:-dev-only-insecure-secret-do-not-use-in-production} nodemon --env-file-if-exists=../.env server.js",
    "verify:hours": "node --env-file-if-exists=../.env verifyHours.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
