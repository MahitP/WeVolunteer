{
  "name": "wevolunteer-app",
  "private": true,
  "version": "1.2.0",
  "description": "Volunteer scheduling and service-hour tracking for schools and community organizations",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:client": "vite --host",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:ai": "VITE_LOCAL_AI=true npm run dev",
    "dev:no-ai": "VITE_LOCAL_AI=false npm run dev",
    "build": "vite build",
    "build:no-ai": "VITE_LOCAL_AI=false vite build",
    "start": "npm start --workspace=server",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset:dev": "node --env-file-if-exists=.env bin/reset-dev-db.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:postgres": "WEV_POSTGRES_APP_TEST=1 vitest run --project server",
    "pinecone:setup": "node --env-file-if-exists=.env bin/pinecone-index.mjs setup",
    "pinecone:backfill": "node --env-file-if-exists=.env bin/pinecone-index.mjs backfill",
    "pinecone:reindex": "node --env-file-if-exists=.env bin/pinecone-index.mjs reindex",
    "pinecone:reconcile": "node --env-file-if-exists=.env bin/pinecone-index.mjs reconcile",
    "pinecone:stats": "node --env-file-if-exists=.env bin/pinecone-index.mjs stats",
    "redis:status": "node --env-file-if-exists=.env bin/upstash-redis.mjs status",
    "redis:ping": "node --env-file-if-exists=.env bin/upstash-redis.mjs ping",
    "redis:keys": "node --env-file-if-exists=.env bin/upstash-redis.mjs keys",
    "redis:validate": "node --env-file-if-exists=.env bin/upstash-redis.mjs validate",
    "a11y": "node bin/a11y-audit.mjs --yes",
    "a11y:local": "VITE_LOCAL_AI=true node bin/a11y-audit.mjs --yes --grep @local",
    "a11y:report": "node bin/a11y-report.mjs",
    "scan:bundle": "node bin/scan-bundle-secrets.mjs"
  },
  "dependencies": {
    "@amplitude/unified": "^1.1.29",
    "@wllama/wllama": "^3.5.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autocannon": "8.0.0",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
