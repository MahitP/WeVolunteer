# ============================================================================
# WeVolunteer — CLIENT build-time configuration (template)
# ============================================================================
#
#   cp .env.production.example .env.production   # then edit, then `npm run build`
#
# `vite build` reads `.env.production` automatically. These values are BAKED
# INTO THE BUNDLE at build time — setting them on the running server does
# nothing. Change any of them and you must rebuild and redeploy.
#
# Nothing here is secret: every value ends up in JavaScript the browser
# downloads. Never put an API key, a database path, or JWT_SECRET in this file.
# Server-side secrets belong in the systemd EnvironmentFile — see
# docs/operations/pilot-deployment-runbook.md §5.
#
# ============================================
# Nothing without a VITE_ prefix belongs here, and that includes tunables
# ============================================
#
# Only `VITE_*` names reach the bundle; Vite ignores everything else, silently.
# So a server setting written here does not take effect somewhere less
# convenient — it does nothing at all, while looking configured. That is a worse
# failure than a missing value, because there is no error to notice.
#
# Every server-side variable, including runtime tunables with no secret in them
# (`ERROR_REPORT_RATE_LIMIT`, `REAUTH_RATE_LIMIT`, `EXPORT_RATE_LIMIT`,
# `LOGIN_FAILURE_LIMIT`, `WEV_DB_PATH`, `TRUST_PROXY`, `CORS_ORIGINS` …), is
# documented in **deploy/wevolunteer.env.example** and set in
# `/etc/wevolunteer/wevolunteer.env`. The two files live at different paths
# precisely so neither can overwrite the other.
# ============================================================================


# ============================================
# Privacy notice
# ============================================
#
# REQUIRED BEFORE LAUNCH.
#
# WeVolunteer stores identifying information about minors — name, grade,
# school, email address — and shows some of it to organizers whose events a
# student applies to.
#
# When this is set, the signup form shows a required acknowledgement checkbox
# linking to it. When it is unset, that control does not render at all (Vite
# removes the block from the bundle), so the app collects this data with no
# disclosure and no consent record.
#
# This is deliberately empty. The URL must point at a privacy notice the
# district has actually reviewed and published. Do not point it at a
# placeholder page: a consent checkbox linking to nothing is worse than no
# checkbox, because it manufactures the appearance of a reviewed policy.
#
# TWO WAYS TO SATISFY THIS:
#
#   1. An external URL, if the district publishes its notice elsewhere:
#        VITE_PRIVACY_URL=https://district.example/privacy
#
#   2. The BUILT-IN notice shipped with the app:
#        VITE_PRIVACY_URL=/privacy
#      It is a real page at that path, readable without an account, and it
#      already states accurately what this software stores and who can see it —
#      those are facts about the code, not policy. It does NOT invent the three
#      things only the district can decide. Supply them below, or the page
#      displays a prominent warning that it is not a finished policy, on every
#      view, above everything else. That warning is the design, not a defect:
#      an unfinished notice that admits it is unfinished is honest, and one that
#      quietly reads as finished is the exact failure this comment warns about.
#
VITE_PRIVACY_URL=


# ============================================
# The three facts the built-in notice cannot know
# ============================================
#
# REQUIRED if VITE_PRIVACY_URL=/privacy. Ignored otherwise.
#
# Free text, shown verbatim. Each is a district decision the district is
# accountable for, so there is no default and nothing is guessed. While any one
# is blank the page marks that section "Not yet provided" and shows the
# not-a-reviewed-policy warning at the top.
#
# Whose policy this is. Shown in the heading and throughout, so a reader knows
# they are reading the district's notice and not the software vendor's.
# VITE_PRIVACY_OWNER=Lincoln Unified School District
#
# How long student records are kept, and what happens at the end of that period.
# VITE_PRIVACY_RETENTION=Volunteer records are kept for three years after graduation, then deleted.
#
# Who a family contacts to correct or delete a record, and how. An account
# holder can always delete their own account from Settings; this is the route
# for everything that is not that.
# VITE_PRIVACY_CONTACT=Email privacy@district.example or call the district office.
#
# Whether accounts under 13 are in scope, and what consent applies to them.
# If under-13 accounts are not permitted, say so here — that is an answer.
# VITE_PRIVACY_UNDER13=Students under 13 require a signed parental consent form before an account is created.


# ============================================
# Public origin printed on certificates
# ============================================
#
# Optional. The origin shown on a printed certificate as the place to verify
# it ("Verify at <host>/verify/WEV-XXXX-XXXX").
#
# Leave blank unless certificates are printed from somewhere other than the
# public address. Blank means the app uses the origin the page was served
# from, which is correct for a normal deployment.
#
VITE_PUBLIC_URL=


# ============================================
# Branding
# ============================================
# Optional. Defaults shown.
#
# VITE_APP_NAME=WeVolunteer
# VITE_SCHOOL_NAME=WeVolunteer Community


# ============================================
# Feature switches
# ============================================
#
# Set to false to remove the community leaderboard entirely. It is already
# opt-in per student and default-off; this is the belt-and-braces option if the
# district would rather it not exist at all.
#
# VITE_ENABLE_LEADERBOARD=false


# ============================================
# Never set in production
# ============================================
#
# VITE_DEMO_MODE exposes one-click sign-in as seeded demo accounts, including an
# administrator, using a password published in the README. It lives only in
# `.env.development`, which `vite build` does not read. Do not add it here.



