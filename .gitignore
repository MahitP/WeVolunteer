# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Real production build config. `.env.production.example` is the committed
# template; the filled-in copy is per-deployment and stays out of git.
.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.claude
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated at runtime — initDatabase() rebuilds and reseeds it on boot
*.db
server/*.db

# Generated knowledge-graph output
graphify-out

# Local scratch space — throwaway deployment-check copies of the project.
# Never commit: it is ~122 MB of duplicated source, and because it contains
# full copies of server/ and src/ it is also picked up by vitest and oxlint,
# which turns a passing suite (25 files / 256 tests) into a failing one
# (73 files / 36 failures) against code that is not part of the repository.
scratch/

# Saved reference webpage kept for design comparison, not project source
SignUp Genius/

# SQLite WAL sidecars (created at runtime alongside *.db)
*.db-wal
*.db-shm
playwright-report/
test-results/

# Pilot environment credentials
docs/operations/pilot-credentials.md
backups/

# ── Secrets ─────────────────────────────────────────────────────────────────
# `.env` was committed once (audit finding C-3) because only `.env.production`
# was ignored. It carried a live GOOGLE_CLIENT_SECRET. The rules below ignore
# every local env file by default and re-allow only the committed templates,
# so a new variant (.env.staging, .env.pilot, .env.local) is ignored the moment
# it is created rather than the first time somebody remembers to add a rule.
.env
.env.*
!.env.example
!.env.development
!.env.production.example

# Credential material that must never enter the repository.
*.p8
*.p12
*.pem
*.key
!**/*.pub.pem
service-account*.json
gha-creds-*.json
