*.db
server/*.db

# Generated knowledge-graph output
graphify-out

# Local scratch space — throwaway deployment-check copies of the project.
# Never commit: it is ~122 MB of duplicated source, and because it contains
# full copies of server/ and src/ it is also picked up by vitest and oxlint,
# which turns a passing suite (25 files / 256 tests) into a failing one
# (73 files / 36 failures) against code that is not part of the repository.
scratch/

# Saved reference webpage kept for design comparison, not project source
SignUp Genius/

# SQLite WAL sidecars (created at runtime alongside *.db)
*.db-wal
*.db-shm

# Database backups, under any suffix.
#
# `*.db` above stops `pilot.db`; it does not stop `pilot.db.backup-20260810`,
# because the extension is no longer last. Taking a copy before a migration
# repair is the correct instinct — ENGINEERING_GUIDE §8.3 requires it for a
# rebuild — and the file it leaves behind is a full copy of a live database:
# every student's name, address, date of birth and password hash. That must
# never be one `git add -A` away from the history.
#
# Deny by default, like the env rules further down. The pattern names the CLASS
# (anything alongside a database that looks like a copy) rather than a filename,
# which is the rule that would have caught it.
# No negations here: the sidecars above end in `-wal`/`-shm`, a HYPHEN, so
# `*.db.*` (a DOT after `db`) never matches them and re-allowing them would
# only undo the rules two lines up.
*.db.*
*.sqlite.*
*.bak

# Generated data-export archives. Written beside the database (see
# exportWorker.resolveExportDir), so in development that is the repository root.
# Each zip is one user's complete personal record — profile, messages, attendance,
# certificates — and must never be committed.
exports/
*.zip
playwright-report/
test-results/

# Captured test output. `test_output.txt` was tracked and carried 991 lines of
# vitest stdout including raw ANSI escape codes — a debug artifact that goes
# stale the moment the suite changes, and reads as authoritative when it isn't.
# Run `npm test` for current results.
test_output.txt
test-output.txt
*.tap

# Spent one-off codemod. `update_css.cjs` rewrote src/index.css to add the dark
# theme; that edit is long since applied and committed, nothing references the
# script, and re-running it against today's index.css would corrupt it. Kept on
# disk for reference, out of the release.
update_css.cjs

# Pilot environment credentials
docs/operations/pilot-credentials.md
backups/

# ── Secrets ─────────────────────────────────────────────────────────────────
# `.env` was committed once (audit finding C-3) because only `.env.production`
# was ignored. It carried a live GOOGLE_CLIENT_SECRET. The rules below ignore
# every local env file by default and re-allow only the committed templates,
# so a new variant (.env.staging, .env.pilot, .env.local) is ignored the moment
# it is created rather than the first time somebody remembers to add a rule.
.env
.env.*
!.env.example
!.env.development
!.env.production.example

# Credential material that must never enter the repository.
*.p8
*.p12
*.pem
*.key
!**/*.pub.pem
service-account*.json
gha-creds-*.json

# Runtime SQLite databases. `*.db` above does not cover the `.sqlite`
# extension, and `server/database.sqlite` was sitting untracked and
# committable — a live database file one broad `git add` away from the repo.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# User-uploaded files. `server/public/uploads/` is where profile pictures land
# at runtime, and it was untracked and committable — a real student's photograph
# one broad `git add` away from the repository, and from every clone of it
# thereafter. Same class of mistake as the `.sqlite` rule above: a runtime
# artefact that looks like source because it sits under `server/`.
#
# The directory itself is not tracked either. `profilePictureRoutes.js` creates
# it on demand (`mkdirSync` with `recursive: true`), so nothing depends on it
# existing in a fresh clone.
server/public/uploads/
