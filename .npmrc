# Make the `engines` field in package.json a hard requirement rather than a warning.
#
# npm's default is `engine-strict=false`: a Node version outside the declared range
# produces a warning and installs anyway. That is not good enough here, because the
# entire persistence layer is `node:sqlite`, which Node still marks EXPERIMENTAL —
# its API is explicitly allowed to change between majors, and the failure mode is
# silent misreads or failed writes of student attendance and credited hours rather
# than a clean error.
#
# With this set, `npm install` and `npm ci` FAIL on an unsupported major instead of
# proceeding. Paired with the runtime check in server/nodeVersion.js (enforced via
# server/preflight.js as the first import), that covers both halves: install time and
# boot time.
#
# The supported range lives in package.json `engines`; see also .nvmrc for the exact
# version this release was tested against.
engine-strict=true

# Deterministic installs on the deployment host. `npm ci` already respects the
# lockfile, but this makes `npm install` refuse to silently update it too, so a
# deploy cannot quietly pick up a different dependency tree than the one tested.
save-exact=false
