# ============================================
# WeVolunteer — Vite development environment
# ============================================
#
# Read by Vite ONLY, and only in development. `vite build` does not read this
# file, so the demo account switcher and the seeded sign-in shortcuts on the
# login page cannot reach a production bundle.
#
# Everything here is PUBLIC. Vite exposes names beginning with VITE_ by
# compiling them into the JavaScript the browser downloads, so a value in this
# file is readable with View Source. Never put a secret in it.
#
# Server-side settings — database paths, API keys, Pinecone, SMTP — belong in
# `.env`, which is git-ignored. Vite does read `.env` as well, but it exposes
# only VITE_-prefixed names from it, so a server secret there stays server-side.
# A non-VITE_ name written in THIS file does nothing at all: the server never
# reads it, which is a silent failure rather than a loud one.

VITE_DEMO_MODE=true
