# Loaded automatically by Vite in development only. `vite build` does not read
# this file, so the demo account switcher and the seeded sign-in shortcuts on
# the login page cannot reach a production bundle.
VITE_DEMO_MODE=true

# Only VITE_-prefixed names belong here, and only ones that are safe to ship in
# a browser bundle. Server-side settings — database paths, API keys, Pinecone,
# SMTP — go in `.env`, which Vite never reads and git never tracks.
