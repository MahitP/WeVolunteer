# ─────────────────────────────────────────────────────────────────────────────
# WeVolunteer — SERVER runtime environment (template)
#
#   sudo install -d -m 750 -o root -g wev /etc/wevolunteer
#   sudo install -m 640 -o root -g wev deploy/wevolunteer.env.example \
#        /etc/wevolunteer/wevolunteer.env
#   sudo nano /etc/wevolunteer/wevolunteer.env      # fill in every REPLACE_ME
#
# Read by systemd via `EnvironmentFile=` in deploy/wevolunteer.service.
#
# ── This file is NOT the frontend config ─────────────────────────────────────
#
# There are two environment files and they must never be merged:
#
#   /etc/wevolunteer/wevolunteer.env   THIS FILE — server secrets, read at
#                                      runtime by systemd. Never in the repo.
#
#   /srv/wevolunteer/.env.production   Frontend build vars (VITE_*) only, read
#                                      by `npm run build`. See
#                                      .env.production.example in the repo root.
#
# They live at different paths precisely so one cannot overwrite the other.
# Putting VITE_* here does nothing — the frontend is compiled before this file
# is ever read. Putting secrets in the other file is pointless and risky.
#
# ── Format notes ─────────────────────────────────────────────────────────────
#
# systemd parses this file itself; it is NOT shell. Do not use `export`, and do
# not rely on shell expansion — `$VAR` is not interpolated. A value may contain
# spaces without quoting: everything after the first `=` is taken literally.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required. The server refuses to start without these. ─────────────────────

NODE_ENV=production

# Signing key for session tokens. Generate with: openssl rand -hex 32
# Anyone holding this can mint a token for any user, including an administrator.
JWT_SECRET=REPLACE_ME

# AES-256 key encrypting stored two-factor secrets, base64, exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Treat this like a backup key rather than a rotatable secret: there is no
# re-encryption path, so changing or losing it makes every enrolled user's TOTP
# secret undecryptable and each account has to be cleared individually with
# bin/reset-2fa.mjs. Back it up wherever you back up the database.
TFA_ENCRYPTION_KEY=REPLACE_ME

# Whether an administrator must hold a second factor to use their privileges.
#
# Defaults to ON. Leave it unset in production — the server REFUSES TO BOOT if
# it is set to "false" while NODE_ENV=production, because an administrator holds
# every capability on the platform and a password alone is not enough to stand
# behind that.
#
# The only value of setting it at all is "false" on a development or demo
# database whose seeded administrator fixtures have no authenticator enrolled.
# Accepts exactly "true", "false", or nothing; any other value is a boot error
# rather than a silently-ignored typo.
# REQUIRE_ADMIN_2FA=true

# Absolute base URL of this deployment. Used to build the links in
# password-reset and email-verification messages. A wrong value emails live
# single-use tokens to a domain you do not control. No trailing slash.
APP_URL=https://volunteers.example.org

# Outbound mail relay. All three are required.
SMTP_HOST=smtp.example.net
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME


# ── Strongly recommended ─────────────────────────────────────────────────────

# Where the SQLite database lives. Keep it OUT of /srv/wevolunteer so a
# redeploy or `git clean` can never touch it. Must match the WEV_DB_PATH in
# deploy/wevolunteer-backup.service.
WEV_DB_PATH=/var/lib/wevolunteer/wevolunteer.db

# Browser origins allowed to call the API from another origin. Same-origin
# requests always pass, so the single-host topology works without this — set it
# anyway, it is your only control if the client is ever served elsewhere.
CORS_ORIGINS=https://volunteers.example.org

# Number of reverse proxies in front of the app. Required for per-IP rate
# limiting to see the real client. Unset behind a proxy = every user shares one
# bucket. Set without a proxy = clients can forge X-Forwarded-For.
TRUST_PROXY=1

# Interface the HTTP server binds. The DEFAULT IS 0.0.0.0 — i.e. reachable on
# every interface the host has, which bypasses nginx and therefore TLS and HSTS.
# For the single-host topology in the runbook, set loopback and firewall the port
# as well. An earlier revision of the runbook wrongly claimed loopback was
# hardcoded; it never was.
BIND_ADDRESS=127.0.0.1

# Where completed data-export archives are written. Each one is a single student's
# complete personal record, so this must be durable, backed-up storage owned by the
# service user. Defaults to an `exports/` directory beside WEV_DB_PATH, which is
# already covered by the unit's ReadWritePaths. Do NOT point this at /tmp: the unit
# sets PrivateTmp=true, so /tmp is destroyed on every restart while the database
# still promises the file for seven days.
# WEV_EXPORT_DIR=/var/lib/wevolunteer/exports

# 587 = STARTTLS (default), 465 = implicit TLS. Nothing else is special-cased.
SMTP_PORT=587


# ── Optional ─────────────────────────────────────────────────────────────────

# The From header on outbound mail. Must be an address your relay may send as,
# and covered by your SPF/DKIM records.
#
# A bare address needs no quoting. If you want a display name, quote the WHOLE
# value — both parsers that read this file (systemd, and `node --env-file` for
# the one-off commands in the runbook) strip a surrounding pair of quotes and
# keep everything inside:
#   EMAIL_FROM="WeVolunteer <noreply@example.org>"
#
# Do NOT quote only the display name. `EMAIL_FROM="WeVolunteer" <noreply@x>`
# parses as just `WeVolunteer` under `node --env-file` — the address is silently
# dropped and mail goes out with a malformed From header.
EMAIL_FROM=noreply@example.org

# Cap on password-reset / resend-verification requests per 15 minutes, keyed on the
# TARGET ADDRESS (or the session, for the authenticated resend endpoint) — not on IP.
# A school campus egresses from one public address, so a per-IP cap of 5 meant the
# whole building shared five verification emails per window on signup day.
# MAIL_RATE_LIMIT=5
#
# Per-IP ceiling underneath the per-address cap, so rotating the address cannot buy
# unlimited mail. Generous by design: it should only ever be hit by an
# address-enumeration attempt, never by a legitimate cohort.
# MAIL_IP_CEILING=120

# Failed sign-in attempts per 15 minutes, keyed on the DEVICE **and the account
# being tried** — not on the device alone. Successes are not counted.
#
# Per-IP-only was a school-wide lockout: ten different students each mistyping once
# exhausted the shared budget for the whole building, and the eleventh student —
# typing the CORRECT password — was refused with 429 for the rest of the window.
# Keying on the pair means one student's typos cannot spend another's allowance,
# while a single account still tolerates only this many failures from one device.
# The account-level counter in authRoutes.js (LOGIN_FAILURE_LIMIT, 10 per 15
# minutes, keyed on the account across ALL devices) is what bounds brute force.
# LOGIN_RATE_LIMIT=10
#
# Per-IP ceiling underneath the per-account limiter above: total FAILED sign-ins
# one address may accumulate across however many accounts, per 15 minutes. This is
# the anti-password-spray bound, and it is what makes per-account keying safe.
#
# Set above what a school generates and below what a spray needs. A
# two-thousand-student building on signup morning, a few percent mistyping once, is
# on the order of a hundred failures per quarter hour; a spray worth running wants
# thousands. Raise it for a larger population — but never so far that spraying
# becomes free, and never lower it to the point where a busy morning trips it.
# LOGIN_IP_CEILING=200

# ── The other rate limits ────────────────────────────────────────────────────
#
# Listed because they exist, not because you should change them. Each is a
# security control with a measured default, and an operator who does not know a
# control exists cannot tune it, audit it, or explain it to a district — which
# is the only reason these are written down here rather than left in the code.
#
# All four read as `Number(process.env.X) || <default>`, so **0 does not mean
# zero** — it is falsy and silently restores the default. To block traffic, stop
# the endpoint at the proxy; do not try to express it here.
#
# Client error reports accepted per IP per 15 minutes, on the one unauthenticated
# write endpoint in the application (`POST /api/errors/report`). This bounds
# REQUESTS from one address and nothing else; the 500-group client ceiling in
# errorReporter.js is what bounds ROWS regardless of how many addresses the
# traffic comes from. Neither subsumes the other — see ENGINEERING_GUIDE §6.10.
# Raising it buys a noisier error table, not better diagnostics: a genuine bug is
# already one grouped row with a counter by the twentieth report.
# ERROR_REPORT_RATE_LIMIT=20
#
# Step-up re-authentication attempts per 15 minutes. This is the throttle on
# guessing a password at the AAL2 gate, so it is deliberately tight.
# REAUTH_RATE_LIMIT=5
#
# Data-export requests per 15 minutes. Each one assembles a complete copy of one
# account's records, so this bounds work as much as it bounds abuse.
# EXPORT_RATE_LIMIT=3
#
# Consecutive failed sign-ins before an account is locked out. Keyed on the
# ACCOUNT, not the IP — a campus egresses from one address, so an IP-keyed lockout
# would let one student lock out the school.
# LOGIN_FAILURE_LIMIT=10
#
# ── Check-in codes ───────────────────────────────────────────────────────────
#
# Both scan limits are keyed on the ACCOUNT, not the address. A campus egresses
# from one address, so an IP-keyed limit would let one organizer's rush stop
# every other organizer at the same school from checking anybody in.
#
# Scanning is a token bucket rather than a fixed window, because the traffic is
# a rush and not a stream: a hundred and fifty volunteers arrive in the ten
# minutes around the start and are scanned as fast as a camera can be pointed.
# A window sized for that is enormous for the rest of the day; a window sized
# for the rest of the day stops the organizer at the one moment the feature
# exists for, and the fallback is typing a hundred and fifty names.
#
# Burst capacity: scans one organizer may do back to back with no throttling.
# CHECKIN_SCAN_BURST_LIMIT=150
#
# Sustained scans per minute once the burst is spent. Enough for an all-day
# event, never enough for a machine.
# CHECKIN_SCAN_RATE_LIMIT=30
#
# Check-in codes a volunteer may mint per fifteen minutes. A code lasts five
# minutes, so an honest volunteer needs about three per shift plus retries.
# CHECKIN_CODE_RATE_LIMIT=20


# ── Alerting ─────────────────────────────────────────────────────────────────
#
# SET THIS. It is the only thing that causes anyone to look at the error
# dashboard. Without it the application records its own failures perfectly and
# tells nobody — which is how a pilot discovers a week-old outage from a student
# rather than from the software.
#
# Where to email when a NEW server or worker error appears. Comma-separated for
# more than one. Unset disables alerting entirely; that is the safe default, not
# a recommendation. Uses the SMTP_* settings above — no extra service to run.
#
# What the email contains: how many new problems, each one's error class, its
# fingerprint, and a link to /errors. What it deliberately does NOT contain:
# the error message, the stack trace, the route, or anything about who was
# affected. Those are personal data about minors and an inbox is not
# access-controlled; reading them requires signing in as the platform owner.
# `server/alerting.test.js` fails the build if any of it appears in the body.
#
# Client-side (browser) errors never alert. Their error class is supplied by
# whoever sent the report, and a browser extension throwing on someone's laptop
# is not an incident.
#
# ALERT_EMAIL=ops@district.example
#
# Minimum gap between two alert emails, in milliseconds. Default 3600000 (one
# hour). A cascade produces many distinct problems in seconds; without a floor
# that is one email each, which buries the first — the one that mattered — and
# teaches the recipient to filter the channel. Nothing is dropped by waiting: a
# throttled problem is included in the next digest, because eligibility is "has
# this been alerted on" and not a time window.
# ALERT_MIN_INTERVAL_MS=3600000
#
# ── Backup failures alert separately, through systemd ────────────────────────
#
# Nothing here covers a failed backup: `bin/backup.sh` exits non-zero and systemd
# records a failed unit, but a failed unit nobody looks at is the same as no
# backup. Add an `OnFailure=` to deploy/wevolunteer-backup.service — the runbook
# has the unit. This is a separate mechanism on purpose: a backup job that cannot
# run is exactly the situation where the application may not be running either,
# so routing that alert through the application would be routing it through the
# thing that is broken.

# ── Provider sign-in (optional; email-only is a supported deployment) ────────
#
# Set all three together, or none of them. With client credentials set, the
# server REFUSES TO START unless OAUTH_REDIRECT_URI names this deployment —
# because its built-in default is the development value
# `http://localhost:5173/oauth/callback`, and shipping that would send every user
# who presses "Continue with Google" to their own machine (and, if localhost is
# still registered on the OAuth client, deliver a live authorization code there
# over plain HTTP).
#
# OAUTH_REDIRECT_URI must match a redirect URI registered with the provider
# EXACTLY — scheme, host, port, path. It must be https outside localhost; both
# Google and Microsoft refuse anything else.
#
# GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_ME
# OAUTH_REDIRECT_URI=https://volunteers.example.org/oauth/callback
#
# Microsoft (Entra ID / Microsoft identity platform). Same shape as Google, plus
# an optional tenant restriction. Requires an App Registration in the Azure
# portal — Redirect URI type "Web", set to exactly the OAUTH_REDIRECT_URI above,
# and a client secret from Certificates & secrets. The registration must include
# the delegated `openid`, `profile` and `email` permissions; nothing more is
# requested, and `User.Read` is deliberately NOT needed (the identity comes from
# the ID token, not from a Graph lookup).
# MICROSOFT_CLIENT_ID=REPLACE_ME
# MICROSOFT_CLIENT_SECRET=REPLACE_ME
#
# Which directory may sign in. Unset means `common`: ANY Entra tenant and any
# personal Microsoft account on the internet can complete the flow. That is the
# right default for a district that has not decided, and the wrong one for a
# district that has — set the tenant GUID (Overview → Directory (tenant) ID) and
# every other directory is refused, both at the provider and again on the `tid`
# claim when the token comes back.
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
#
# Apple has no implementation behind it and is always reported as unavailable,
# whatever is set here.
#
# NEVER set OAUTH_ALLOW_MOCK in this file. It replaces the provider with an
# identity read straight out of the request body — anyone could sign in as
# anyone — and a production process that finds it set to "true" refuses to boot
# rather than starting insecure. It exists for automated tests only.

# Total Auto Select draws permitted per event.
# MAX_AUTO_SELECT_DRAWS=5

# Require a confirmed email address before an account can be used.
# Only turn this on once mail delivery is proven — without it, new users are
# locked out with no way through.
# REQUIRE_EMAIL_VERIFICATION=true


# ── Single-instance enforcement ───────────────────────────────────────────────
#
# Exactly ONE instance may run against a database. This is now enforced: a second
# production instance whose predecessor is still heartbeating refuses to boot and
# names the holder. It is a data-integrity control — all rate-limit state is
# per-process memory, and slot-capacity checks read outside their write transaction.
#
# A crashed predecessor never blocks a restart: a dead pid on the same host is
# reclaimed immediately, and a stale heartbeat is reclaimed after this window.
# INSTANCE_LOCK_STALE_MS=45000
# INSTANCE_LOCK_HEARTBEAT_MS=15000

# ── Node runtime ──────────────────────────────────────────────────────────────
#
# The server refuses to start on any Node major other than 24.x, because the whole
# data layer is `node:sqlite`, which Node still marks EXPERIMENTAL — its API may
# change between majors, and the failure mode is silent data damage rather than a
# clean error. `.nvmrc` records the exact tested version.
#
# Only set this if you have deliberately validated another major yourself.
# WEV_ALLOW_UNSUPPORTED_NODE=true

# ── Never set here ───────────────────────────────────────────────────────────
#
# DEMO_MODE seeds accounts sharing a published password (including an admin) and
# raises the rate limits roughly 100x. The server refuses to start if it is
# combined with NODE_ENV=production, but do not add it at all.
#
# It no longer registers any database-reset endpoint: that route was removed
# outright, because it destroyed the database instead of resetting it. Restoring
# a development database is now `npm run db:reset:dev`, which refuses to run when
# NODE_ENV=production.

# ── Travel times (optional) ───────────────────────────────────────────────────
#
# An OpenRouteService API key, used by /api/travel-time to answer "how long is
# the drive to this shift". Sign up at https://openrouteservice.org/dev/#/signup
#
# Leave it unset and the feature turns itself off silently: the route answers
# 503 routing_unconfigured, the page renders no travel time, and the "Get
# directions" link — which needs no provider at all — carries on working. That
# is a supported state, not a broken one.
#
# The key is read only in the server process and is never sent to the browser.
# A key in a browser bundle is a published key.
#
# What the provider receives: a pair of coordinates, coarsened to three decimal
# places (~110 m) before the request leaves this process, in a POST body rather
# than a query string. Nothing identifies the student, and no origin is ever
# written to the database or to a log.
#
# ROUTING_API_KEY=

# How many travel-time requests one ACCOUNT may make per 15 minutes.
# Keyed on a hash of the user id, never on the address: a school NATs its whole
# campus behind one IP, and an IP-keyed limiter once locked out a building.
# TRAVEL_TIME_RATE_LIMIT=60
