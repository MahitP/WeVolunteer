[Unit]
Description=WeVolunteer nightly database backup
Documentation=file:///srv/wevolunteer/docs/operations/pilot-deployment-runbook.md
# Do not run while the database volume is unavailable.
RequiresMountsFor=/var/lib/wevolunteer

[Service]
Type=oneshot
User=wev
Group=wev

# Paths must match the running service's WEV_DB_PATH. If you relocate the
# database, change it here too — a backup job silently pointing at a path that
# no longer exists is the classic way to discover you have no backups.
Environment=WEV_DB_PATH=/var/lib/wevolunteer/wevolunteer.db
Environment=WEV_BACKUP_DIR=/var/backups/wevolunteer
Environment=WEV_BACKUP_KEEP_DAYS=14

ExecStart=/srv/wevolunteer/bin/backup.sh

# The script exits non-zero on a failed integrity check, so systemd records a
# failed unit rather than a silent success. `OnFailure` below turns that into
# something a human sees.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wevolunteer
# The database itself is only ever read by `.backup`, but SQLite needs to open
# it read-write to take a consistent online copy.
ReadWritePaths=/var/lib/wevolunteer

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
