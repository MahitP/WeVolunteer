[Unit]
Description=WeVolunteer nightly database backup
# A failed run is reported to the BACKUP heartbeat immediately; a run that never
# happens is caught by the heartbeat's own schedule. See the note under
# ExecStartPost below.
OnFailure=wevolunteer-heartbeat-fail@%n.service
Documentation=file:///srv/wevolunteer/docs/operations/pilot-deployment-runbook.md
# Do not run while the database volume is unavailable.
RequiresMountsFor=/var/lib/wevolunteer

[Service]
Type=oneshot
User=wev
Group=wev

# ── Which script runs, and why this line changed ───────────────────────────
#
# This unit ran `bin/backup.sh`, which is sqlite3-only. Production is
# PostgreSQL, so the nightly job would have invoked a tool that cannot read the
# database it is meant to protect — the exact failure the comment below warns
# about, one engine further along, and invisible until a restore was needed.
#
# `bin/backup-postgres.sh` needs DATABASE_URL, which is a secret and therefore
# comes from the same EnvironmentFile the application uses rather than being
# written here. `EnvironmentFile=-` tolerates its absence so a SQLite host does
# not fail to start the timer; the script itself refuses to run without a
# connection string, which is the check that matters.
EnvironmentFile=-/etc/wevolunteer/wevolunteer.env
# The heartbeat URL, kept apart from the application's secrets so the units that
# only report (refresh, host check, failure template) never load DATABASE_URL.
EnvironmentFile=-/etc/wevolunteer/heartbeats.env

Environment=WEV_BACKUP_DIR=/var/backups/wevolunteer
Environment=WEV_BACKUP_KEEP_DAYS=14

# pg_dump refuses to dump a server newer than itself and leaves a ZERO-BYTE
# file behind. Supabase runs PostgreSQL 17; a distribution's default client is
# often older. Set this to a client whose major matches the server — the script
# compares the two before doing any work and names this variable if they differ.
#   Debian/Ubuntu:  apt install postgresql-client-17
Environment=WEV_PG_BIN=/usr/lib/postgresql/17/bin

ExecStart=/srv/wevolunteer/bin/backup-postgres.sh

# ── Alerting: a heartbeat, which also catches the run that never happens ──
#
# ExecStartPost runs only after ExecStart succeeded, so this pings the BACKUP
# heartbeat (HEARTBEAT_URL_BACKUP, from heartbeats.env above) exactly when
# a verified archive exists. OnFailure= in [Unit] reports an explicit failure.
# Better Stack raises an incident on that failure AND when a day passes with no
# ping — which is the case nothing else here can see: the timer disabled, the
# host down at 03:00, the unit never started. Unset, the script says the job is
# unmonitored and exits 0; it can never fail the backup.
ExecStartPost=/usr/local/sbin/wevolunteer-heartbeat.sh BACKUP ok

# The script exits non-zero on a failed integrity check, so systemd records a
# failed unit rather than a silent success.
#
# ── History: what the alerting note used to say ──
#
# This file once claimed "`OnFailure` below turns that into something a human
# sees" with no OnFailure= anywhere, and was then corrected to say plainly that
# nothing alerted. Both are now superseded by the heartbeat above. Two further
# safety nets remain:
#
#   1. /api/admin/system/status and the Owner Center report backup freshness.
#   2. `bin/verify-restore-postgres.sh` rehearses an actual restore. A backup
#      nobody has restored is a hypothesis.
#
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wevolunteer
# Retained for the SQLite path and for the manifest/scratch files the PostgreSQL
# script writes beside the database directory. pg_dump itself reaches the server
# over the network and needs no local write access to the data.
ReadWritePaths=/var/lib/wevolunteer

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
