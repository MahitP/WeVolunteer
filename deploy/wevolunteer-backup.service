[Unit]
Description=WeVolunteer nightly database backup
Documentation=file:///srv/wevolunteer/docs/operations/pilot-deployment-runbook.md
# Do not run while the database volume is unavailable.
RequiresMountsFor=/var/lib/wevolunteer

[Service]
Type=oneshot
User=wev
Group=wev

# Paths must match the running service's WEV_DB_PATH. If you relocate the
# database, change it here too — a backup job silently pointing at a path that
# no longer exists is the classic way to discover you have no backups.
Environment=WEV_DB_PATH=/var/lib/wevolunteer/wevolunteer.db
Environment=WEV_BACKUP_DIR=/var/backups/wevolunteer
Environment=WEV_BACKUP_KEEP_DAYS=14

ExecStart=/srv/wevolunteer/bin/backup.sh

# The script exits non-zero on a failed integrity check, so systemd records a
# failed unit rather than a silent success.
#
# ── Alerting is NOT configured here, and that is a deliberate statement ──
#
# This comment used to read "`OnFailure` below turns that into something a human
# sees" — and there was no OnFailure= directive anywhere in this file. Anyone
# reading the unit to check whether backup failures were alerted would have
# concluded that they were. They were not, and had not been for the whole life of
# the file.
#
# Nothing is silently added in its place, because an alert target is
# environment-specific: this project cannot know whether the district uses email, a
# webhook, Nagios, or nothing at all. Inventing a unit name here would produce a
# second kind of lie — a dangling OnFailure= pointing at a unit that does not
# exist, which systemd logs and ignores.
#
# So: THERE IS NO ALERTING ON THIS UNIT UNTIL YOU ADD IT. Two things exist to
# reduce what that costs you:
#
#   1. The application reports backup freshness on /api/admin/system/status, which
#      surfaces in the admin dashboard. A stale or missing backup is visible to a
#      school administrator without an SSH session. That is a safety net, not a
#      replacement for alerting — it cannot tell "the timer is disabled" from "the
#      timer ran and failed".
#
#   2. `bin/verify-restore.sh` rehearses an actual restore from the newest archive.
#      A backup nobody has restored is a hypothesis.
#
# To wire real alerting, create your alert unit and add a drop-in:
#
#   sudo systemctl edit wevolunteer-backup.service
#   # [Unit]
#   # OnFailure=your-alert-unit@%n.service
#
# See deploy/README.md § Alerting and the runbook's monitoring section.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wevolunteer
# The database itself is only ever read by `.backup`, but SQLite needs to open
# it read-write to take a consistent online copy.
ReadWritePaths=/var/lib/wevolunteer

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
