[Unit]
Description=WeVolunteer volunteer sign-up platform
Documentation=file:///srv/wevolunteer/docs/operations/pilot-deployment-runbook.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/wevolunteer

[Service]
Type=simple
User=wev
Group=wev
WorkingDirectory=/srv/wevolunteer

# Server secrets and runtime config. systemd parses this file itself, so values
# containing spaces need no quoting. This is deliberately NOT the frontend's
# .env.production — see deploy/wevolunteer.env.example for why they are separate.
EnvironmentFile=/etc/wevolunteer/wevolunteer.env

# systemd requires an absolute path here, so `env` is used to resolve `node`
# from the service PATH rather than hardcoding /usr/bin/node.
#
# That PATH is systemd's own default (/usr/local/sbin:/usr/local/bin:/usr/sbin:
# /usr/bin:/sbin:/bin), which is where a NodeSource install lands. An nvm
# install does NOT work here: it lives under a user's home directory, and this
# service runs as `wev`, whose shell is nologin. Install Node system-wide.
#
# Verify before enabling:  /usr/bin/env node --version   (must be v24.x)
#
# ── --import is load-bearing for tracing, and is not optional ────────────────
#
# It installs OpenTelemetry's ESM loader hook BEFORE the application's module
# graph is loaded. Without it, express is read before the hook exists, the
# Express instrumentation silently applies to nothing, and every trace shows one
# span named `GET` instead of four named `GET /api/events/:id`. Nothing errors;
# the dashboard is just quietly less useful. See server/observability/register.mjs.
#
# Losing this flag is therefore a real regression, so the application WARNS at
# boot when it is absent:
#
#     [otel] WARNING: the ESM loader hook was not preloaded ...
#
# If you see that line, this is the line that is wrong.
ExecStart=/usr/bin/env node --import ./server/observability/register.mjs server/server.js

Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

# ── Filesystem confinement ───────────────────────────────────────────────────
#
# ProtectSystem=strict makes the ENTIRE filesystem read-only except the paths
# named below — including /srv/wevolunteer, where the checkout lives. That is
# the intended hardening, and it has one consequence worth stating plainly
# because it is not obvious and it breaks the boot:
#
#   The application's default uploads directory is <checkout>/public/uploads,
#   resolved from the module's own location. It is created at IMPORT time. On
#   this unit that path is inside the read-only mount, so without the override
#   below the service does not fail at upload — it fails to START, with EROFS.
#
# So WEV_UPLOADS_DIR must be set in /etc/wevolunteer/wevolunteer.env:
#
#     WEV_UPLOADS_DIR=/var/lib/wevolunteer/uploads
#
# and the directory must exist and be owned by the service user:
#
#     sudo install -d -o wev -g wev -m 750 /var/lib/wevolunteer/uploads
#
# Export archives already default to /var/lib/wevolunteer/exports (they derive
# from WEV_DB_PATH), so they need no override on the standard layout — but a
# PostgreSQL deployment that leaves WEV_DB_PATH unset should set WEV_EXPORT_DIR
# explicitly for the same reason.
#
# The application refuses to start with a message naming this exact fix rather
# than an EROFS stack trace. See server/routes/profilePictureRoutes.js.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wevolunteer

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
